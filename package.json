{
  "name": "vela-cli",
  "version": "0.1.0",
  "private": true,
  "description": "VELA 项目管理 CLI",
  "type": "module",
  "bin": {
    "vela": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=26 <27"
  },
  "volta": {
    "node": "26.13.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/hours.test.mjs",
    "prepack": "npm run build",
    "install:skill": "sh scripts/install-skill.sh",
    "pack:release": "sh scripts/pack-release.sh"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "playwright": "^1.58.2",
    "pngjs": "^7.0.0",
    "proper-lockfile": "^4.1.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/proper-lockfile": "^4.1.4",
    "@types/qrcode": "^1.5.6",
    "tsdown": "^0.23.5",
    "typescript": "~6.0.0"
  }
}
